{
  "name": "json-rpc-mp",
  "description": "Data exchange with the parent window is performed via messaging using the JSON-RPC 2.0",
  "version": "0.0.0",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.esm.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs.js"
      }
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {},
  "keywords": [
      "JSON-RPC 2.0",
      "iframe",
      "MessagePort",
      "MessageChannel"
    ]  
}
